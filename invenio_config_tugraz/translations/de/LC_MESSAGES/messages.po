#: invenio_config_tugraz/config.py:87
msgid "Welcome to TU Graz Repository!"
msgstr "Willkommen im TU Graz Repository!"

#: invenio_config_tugraz/templates/security/email/welcome.txt:1
msgid "Dear user,"
msgstr "Lieber Nutzer,"

#: invenio_config_tugraz/templates/security/email/welcome.txt:3
msgid "Welcome to the Repository of TU Graz!"
msgstr "Willkommen im TU Graz Repository!"

#: invenio_config_tugraz/templates/security/email/welcome.txt:5
msgid "To help you get started, here are some useful links:"
msgstr ""
"Um Ihnen den Einstieg zu erleichtern, finden Sie hier einige nützliche "
"Links:"

#: invenio_config_tugraz/templates/security/email/welcome.txt:7
msgid "Guidelines:"
msgstr "Leitfaden:"

#: invenio_config_tugraz/templates/security/email/welcome.txt:7
msgid "Repository Manual"
msgstr "Handbuch"

#: invenio_config_tugraz/templates/security/email/welcome.txt:7
msgid "how to upload files"
msgstr "wie man Dateien hochlädt"

#: invenio_config_tugraz/templates/security/email/welcome.txt:8
msgid "Search Guide"
msgstr "Suchanleitung"

#: invenio_config_tugraz/templates/security/email/welcome.txt:9
msgid "Terms And Conditions"
msgstr "Nutzungsbedingungen"

#: invenio_config_tugraz/templates/security/email/welcome.txt:10
msgid "Data Protection Rights"
msgstr "Datenschutzerklärung"

#: invenio_config_tugraz/templates/security/email/welcome.txt:13
msgid "You can confirm your email through the link below:"
msgstr "Sie können Ihre E-Mail über den folgenden Link bestätigen:"

#: invenio_config_tugraz/templates/security/email/welcome.txt:16
msgid ""
"If you require any assistance please do not hesitate to contact us at "
"repository-support@tugraz.at."
msgstr ""
"Wenn Sie Hilfe benötigen, zögern Sie bitte nicht, uns unter repository-"
"support@tugraz.at zu kontaktieren."

#: invenio_config_tugraz/templates/security/email/welcome.txt:18
msgid "Best regards,"
msgstr "Mit freundlichen Grüßen,"

#: invenio_config_tugraz/templates/security/email/welcome.txt:19
msgid "TU Graz Repository Team"
msgstr "TU Graz Repository Team"

#: invenio_config_tugraz/config.py:457
msgid "Welcome to our updated user interface"
msgstr "Willkommen in unserer aktualisierten Benutzeroberfläche"

#: invenio_config_tugraz/config.py:459
msgid "A few quick pointers to help you find your way around. You will see this message only once."
msgstr "Ein paar kurze Hinweise, damit Sie sich zurechtfinden. Diese Meldung wird nur einmal angezeigt."

#: invenio_config_tugraz/config.py:464
msgid "Search: Use the dropdown on the homepage to search across all resource types"
msgstr "Suche: Verwenden Sie das Dropdown-Menü auf der Startseite, um alle Ressourcentypen zu durchsuchen"

#: invenio_config_tugraz/config.py:469
msgid "Research data: Upload and manage research data from the Dashboard"
msgstr "Forschungsdaten: Laden Sie Forschungsdaten über das Dashboard hoch und verwalten Sie sie"

#: invenio_config_tugraz/config.py:476
msgid "Publications: Upload and manage publications from the Dashboard"
msgstr "Publikationen: Laden Sie Publikationen über das Dashboard hoch und verwalten Sie sie"

#: invenio_config_tugraz/config.py:483
msgid "Educational resources: Upload and manage educational resources from the Dashboard"
msgstr "Bildungsressourcen: Laden Sie Bildungsressourcen über das Dashboard hoch und verwalten Sie sie"

#: invenio_config_tugraz/config.py:490
msgid "Requests & curation: Find requests, open requests and curation activities in the Dashboard"
msgstr "Anfragen & Kuratierung: Anfragen, offene Anfragen und Kuratierungsaktivitäten finden Sie im Dashboard"

#: invenio_config_tugraz/config.py:482
msgid "Communities: Browse existing communities or create a new one from the Communities menu"
msgstr "Communities: Durchsuchen Sie bestehende Communities oder erstellen Sie eine neue über das Menü „Communities“"

#: invenio_config_tugraz/config.py:486
msgid "Help: Find the user manual, supported file formats and contact information under Help"
msgstr "Hilfe: Benutzerhandbuch, unterstützte Dateiformate und Kontaktinformationen finden Sie unter „Hilfe“"

#: invenio_config_tugraz/config.py:490
msgid "Please acknowledge this message to continue."
msgstr "Bitte bestätigen Sie diese Meldung, um fortzufahren."

#: invenio_config_tugraz/config.py:514
msgid "Search: Use the dropdown on the homepage to search research results"
msgstr "Suche: Verwenden Sie das Dropdown-Menü auf der Startseite, um Forschungsergebnisse zu durchsuchen"

#: invenio_config_tugraz/config.py:518
msgid "Communities: Browse existing communities from the Communities menu"
msgstr "Communities: Durchsuchen Sie bestehende Communities über das Menü „Communities“"

#: invenio_config_tugraz/config.py:522
msgid "Help: Find help and guides under Help"
msgstr "Hilfe: Hilfe und Anleitungen finden Sie unter „Hilfe“"

#: invenio_config_tugraz/config.py:523
msgid "Log in: Sign in to upload and to see publications, educational resources and your dashboard"
msgstr "Anmelden: Melden Sie sich an, um hochzuladen und Publikationen, Bildungsressourcen und Ihr Dashboard zu sehen"

#: invenio_config_tugraz/config.py:504
msgid "Acknowledged"
msgstr "Zur Kenntnis genommen"

